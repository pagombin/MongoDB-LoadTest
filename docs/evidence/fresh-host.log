
### Network with no route to the internet, joined by the replica set
$ docker network create --internal ballast-offline
ee08563837fb408820375083af10a027a724cbcea8cade593779da1ef6cff217
(exit 0)
$ docker run -d --name droplet --hostname droplet --network ballast-offline ballast-droplet-sim
6933b2975a021a6201d4e3ea9a73f036a4cd6b17a333e8abf3d6a72ab4779667
(exit 0)
droplet address: 172.19.0.5

### The host has no internet access and no sudo
$ [bench@droplet] curl -sS -m 5 -o /dev/null https://pypi.org/ || echo 'no internet: as expected'
curl: (6) Could not resolve host: pypi.org
no internet: as expected
(exit 0)
$ [bench@droplet] command -v sudo || echo 'no sudo: as expected'
no sudo: as expected
(exit 0)
$ [bench@droplet] id
uid=1001(bench) gid=1001(bench) groups=1001(bench)
(exit 0)

### Copy the bundle in with scp-like copy, extract as the normal user
$ docker cp dist/ballast-1.0.0-linux-amd64.tar.gz droplet:/home/bench/ && docker exec droplet chown bench:bench /home/bench/ballast-1.0.0-linux-amd64.tar.gz
(exit 0)
$ [bench@droplet] tar -xzf ballast-1.0.0-linux-amd64.tar.gz && ls ballast-1.0.0
