### Configure: all interfaces, certificate paths outside the default, access token
$ [bench@droplet] mkdir -p mycerts && head -c 24 /dev/urandom | base64 > ballast-1.0.0/config/token && chmod 600 ballast-1.0.0/config/token
(exit 0)
$ [bench@droplet] cd ballast-1.0.0 && bin/ballast config validate && bin/ballast config print | grep -E 'listen|cert_file|key_file|access_token_file'
configuration is valid (/home/bench/ballast-1.0.0/config/ballast.yaml)
server.listen = "0.0.0.0:8443"  # file
server.access_token_file = "config/token"  # file
tls.cert_file = "/home/bench/mycerts/ballast.crt"  # file
tls.key_file = "/home/bench/mycerts/ballast.key"  # file
tls.redirect_http_listen = "0.0.0.0:8080"  # file
(exit 0)

